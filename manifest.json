{
    "manifest_version": 3,
    "name": "Prototype Tracker Web",
    "version": "1.0",
    "description": "Capture clics et arbre d'historique avec export JSON",
    "permissions": ["storage","tabs"],
    "host_permissions": ["<all_urls>"],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ],
    "action": {
      "default_popup": "popup.html"
    }
  }