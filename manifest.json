{
    "manifest_version": 3,
    "name": "Tracker Web - Ulaval",
    "version": "1.0",
    "description": "Capture comportementale avec ON/OFF, scroll et temps",
    "permissions": ["storage", "tabs"],
    "host_permissions": ["<all_urls>"],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts":[
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ],
    "action": {
      "default_popup": "popup.html"
    }
}